# Copy to .env.local and fill in your values.
# All EXPO_PUBLIC_* vars are bundled into the client — do not store secrets here.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Use whichever key format your Supabase project provides:
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # newer projects
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...                    # legacy projects
