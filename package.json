    "@shopify/restyle": "^2.4.5",
    "@supabase/supabase-js": "^2.104.1",
    "@tanstack/react-query": "^5.100.5",
    "expo": "~54.0.33",
    "expo-av": "~15.0.0",
    "expo-camera": "~16.0.0",
    "expo-haptics": "~14.0.0",
    "expo-image-picker": "~16.0.0",
    "expo-notifications": "^0.29.14",
    "expo-router": "~4.0.0",
