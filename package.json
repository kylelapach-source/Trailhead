    "react-native-web": "^0.21.2",
    "react-native-webview": "^13.16.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.9.0",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "^55.0.18",
